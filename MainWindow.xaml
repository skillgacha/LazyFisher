<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoClicker"
        mc:Ignorable="d"
        Title="自動クリッカー" Height="600" Width="400"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="CanResize"
        Topmost="{Binding IsChecked, ElementName=ChkAlwaysOnTop}">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Interval -->
            <RowDefinition Height="Auto"/> <!-- Options -->
            <RowDefinition Height="Auto"/> <!-- Repeat -->
            <RowDefinition Height="Auto"/> <!-- Position -->
            <RowDefinition Height="*"/>    <!-- Controls -->
        </Grid.RowDefinitions>

        <!-- Click Interval -->
        <GroupBox Header="クリック間隔" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="5">
                    <TextBox x:Name="TxtHours" Width="40" Text="0" TextAlignment="Center"/>
                    <TextBlock Text="時間" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBox x:Name="TxtMins" Width="40" Text="0" TextAlignment="Center"/>
                    <TextBlock Text="分" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBox x:Name="TxtSecs" Width="40" Text="0" TextAlignment="Center"/>
                    <TextBlock Text="秒" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBox x:Name="TxtMillis" Width="50" Text="100" TextAlignment="Center"/>
                    <TextBlock Text="ミリ秒" HorizontalAlignment="Center" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Click Options -->
        <GroupBox Header="クリックオプション" Grid.Row="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="マウスボタン:"/>
                        <ComboBox x:Name="CboButton" Margin="0,5,0,0">
                            <ComboBoxItem Content="左" IsSelected="True"/>
                            <ComboBoxItem Content="右"/>
                            <ComboBoxItem Content="中"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="クリックタイプ:"/>
                        <ComboBox x:Name="CboType" Margin="0,5,0,0">
                            <ComboBoxItem Content="シングル" IsSelected="True"/>
                            <ComboBoxItem Content="ダブル"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Added Duration Setting -->
                <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                    <TextBlock Text="クリック押し続け時間 (ms):" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtDuration" Width="50" Text="0" TextAlignment="Center"/>
                    <TextBlock Text="(0 = 標準)" Margin="5,0,0,0" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="※ゲーム等で反応しない場合は増やしてください(例: 50)" Margin="5,2,0,0" Foreground="#AAAAAA" FontSize="10"/>
            </StackPanel>
        </GroupBox>

        <!-- Click Repeat -->
        <GroupBox Header="繰り返し設定" Grid.Row="2">
            <StackPanel>
                <RadioButton x:Name="RadioRepeatInfinite" Content="停止するまで繰り返す" IsChecked="True" GroupName="RepeatGroup"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <RadioButton x:Name="RadioRepeatCount" Content="指定回数" VerticalAlignment="Center" GroupName="RepeatGroup"/>
                    <TextBox x:Name="TxtRepeatCount" Width="60" Text="100" Margin="5,0"/>
                    <TextBlock Text="回"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Cursor Position -->
        <GroupBox Header="カーソル位置" Grid.Row="3">
            <StackPanel>
                <RadioButton x:Name="RadioPosCurrent" Content="現在の位置" IsChecked="True" Checked="RadioPos_Checked" GroupName="PositionGroup"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <RadioButton x:Name="RadioPosFixed" Content="固定位置" VerticalAlignment="Center" Checked="RadioPos_Checked" GroupName="PositionGroup"/>

                    <Border x:Name="PanelFixedPos" Margin="10,0,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="X:"/>
                            <TextBox x:Name="TxtPosX" Width="40" Margin="5,0"/>
                            <TextBlock Text="Y:"/>
                            <TextBox x:Name="TxtPosY" Width="40" Margin="5,0"/>
                            <Button x:Name="BtnPickPos" Content="位置をクリップ" Margin="10,0,0,0" Click="BtnPickPos_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Controls -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnStart" Grid.Column="1" Content="開始 (F6)" Width="120" Height="40" Click="BtnStart_Click" Background="#28a745" BorderBrush="#218838" FontWeight="Bold" FontSize="14"/>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="5,0,0,0">
                <CheckBox x:Name="ChkAlwaysOnTop" Content="常に最前面" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ホットキー:" VerticalAlignment="Center" FontSize="10" Margin="0,0,5,0"/>
                    <TextBox x:Name="TxtHotKey" Width="60" Text="F6" IsReadOnly="True" Cursor="Hand"
                             PreviewKeyDown="TxtHotKey_PreviewKeyDown"
                             GotFocus="TxtHotKey_GotFocus"
                             LostFocus="TxtHotKey_LostFocus"
                             ToolTip="クリックしてキーを押すと変更できます"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
